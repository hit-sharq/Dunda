generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

enum MemberRole {
  OWNER
  ADMIN
  GENERAL_MANAGER
  BRANCH_MANAGER
  CASHIER
  WAITER
  BARTENDER
  KITCHEN
  INVENTORY
  EVENT_MANAGER
  FLOOR_STAFF
}

enum OrderStatus {
  DRAFT
  PENDING
  ACCEPTED
  PREPARING
  READY
  SERVED
  PAYMENT_PENDING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  MPESA
  CARD
  OTHER
}

enum StockMovementType {
  PURCHASE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  WASTE
  RETURN
  STOCK_COUNT
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  currency  String   @default("KES")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branches  Branch[]
  members   OrganizationMember[]
  products  Product[]
  categories Category[]
  customers Customer[]
  orders    Order[]
  events    Event[]
  subscription Subscription?
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  clerkUserId    String
  role           MemberRole   @default(WAITER)
  active         Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branches       BranchMember[]
  @@unique([organizationId, clerkUserId])
  @@index([clerkUserId])
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  address        String?
  active         Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        BranchMember[]
  floors         Floor[]
  products       BranchProduct[]
  tables         VenueTable[]
  orders         Order[]
  inventory      InventoryItem[]
  reservations   Reservation[]
  events         Event[]
  @@index([organizationId])
}

model BranchMember {
  id                   String             @id @default(cuid())
  branchId             String
  organizationMemberId String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  member               OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)
  @@unique([branchId, organizationMemberId])
}

model Category {
  id String @id @default(cuid())
  organizationId String
  name String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products Product[]
  @@index([organizationId])
}
model Product {
  id String @id @default(cuid())
  organizationId String
  categoryId String?
  name String
  sku String
  description String?
  active Boolean @default(true)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])
  units ProductUnit[]
  barcodes ProductBarcode[]
  branches BranchProduct[]
  orderItems OrderItem[]
  inventory InventoryItem[]
  @@unique([organizationId, sku])
  @@index([organizationId, name])
}
model ProductUnit {
  id String @id @default(cuid())
  productId String
  name String
  baseQuantity Decimal @db.Decimal(18,6)
  price Decimal @db.Decimal(18,2)
  allowFraction Boolean @default(false)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  @@index([productId])
}
model ProductBarcode {
  id String @id @default(cuid())
  productId String
  barcode String @unique
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}
model BranchProduct {
  id String @id @default(cuid())
  branchId String
  productId String
  active Boolean @default(true)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([branchId, productId])
}

model Floor {
  id String @id @default(cuid())
  branchId String
  name String
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sections FloorSection[]
}
model FloorSection {
  id String @id @default(cuid())
  floorId String
  name String
  floor Floor @relation(fields: [floorId], references: [id], onDelete: Cascade)
  tables VenueTable[]
}
model VenueTable {
  id String @id @default(cuid())
  branchId String
  sectionId String?
  name String
  capacity Int
  status String @default("AVAILABLE")
  branch Branch @relation(fields: [branchId], references: [id])
  section FloorSection? @relation(fields: [sectionId], references: [id])
  orders Order[]
  reservations Reservation[]
  @@index([branchId])
}

model Order {
  id String @id @default(cuid())
  organizationId String
  branchId String
  tableId String?
  orderNumber String
  status OrderStatus @default(DRAFT)
  subtotal Decimal @db.Decimal(18,2)
  tax Decimal @default(0) @db.Decimal(18,2)
  total Decimal @db.Decimal(18,2)
  organization Organization @relation(fields: [organizationId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
  table VenueTable? @relation(fields: [tableId], references: [id])
  items OrderItem[]
  payments Payment[]
  @@unique([branchId, orderNumber])
  @@index([organizationId, branchId, status])
}
model OrderItem {
  id String @id @default(cuid())
  orderId String
  productId String
  unitId String
  quantity Decimal @db.Decimal(18,6)
  unitPrice Decimal @db.Decimal(18,2)
  baseQuantity Decimal @db.Decimal(18,6)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  unit ProductUnit @relation(fields: [unitId], references: [id])
}
model Payment {
  id String @id @default(cuid())
  orderId String
  amount Decimal @db.Decimal(18,2)
  method PaymentMethod
  status PaymentStatus @default(PENDING)
  reference String?
  pesapalTrackingId String?
  order Order @relation(fields: [orderId], references: [id])
  refunds Refund[]
  @@index([orderId, status])
}
model Refund {
  id String @id @default(cuid())
  paymentId String
  amount Decimal @db.Decimal(18,2)
  reason String
  payment Payment @relation(fields: [paymentId], references: [id])
}
model InventoryItem {
  id String @id @default(cuid())
  branchId String
  productId String
  quantity Decimal @db.Decimal(18,6)
  reorderLevel Decimal @default(0) @db.Decimal(18,6)
  branch Branch @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  movements StockMovement[]
  @@unique([branchId, productId])
}
model StockMovement {
  id String @id @default(cuid())
  inventoryItemId String
  type StockMovementType
  quantity Decimal @db.Decimal(18,6)
  reason String?
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  createdAt DateTime @default(now())
}
model Customer {
  id String @id @default(cuid())
  organizationId String
  name String
  phone String?
  email String?
  vip Boolean @default(false)
  organization Organization @relation(fields: [organizationId], references: [id])
  reservations Reservation[]
}
model Reservation {
  id String @id @default(cuid())
  branchId String
  customerId String
  tableId String?
  date DateTime
  guests Int
  status String @default("PENDING")
  branch Branch @relation(fields: [branchId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  table VenueTable? @relation(fields: [tableId], references: [id])
}
model Event {
  id String @id @default(cuid())
  organizationId String
  branchId String
  name String
  date DateTime
  status String @default("DRAFT")
  organization Organization @relation(fields: [organizationId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
}
model AuditLog {
  id String @id @default(cuid())
  organizationId String
  branchId String?
  clerkUserId String
  action String
  entity String
  entityId String
  reason String?
  createdAt DateTime @default(now())
  @@index([organizationId, createdAt])
}
model Subscription {
  id String @id @default(cuid())
  organizationId String @unique
  plan String @default("STARTER")
  status String @default("TRIALING")
  organization Organization @relation(fields: [organizationId], references: [id])
}

// Prisma 7+/8 requires an explicit relation on Organization for Subscription in some generators.
