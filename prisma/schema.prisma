generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model dunda_activity {
  id                  String              @id @default(uuid(7))
  organization_id     String
  branch_id           String?
  type                String
  title               String
  detail              String
  amount              Int?
  timestamp           DateTime            @default(now()) @db.Timestamptz(6)
  dunda_branches      dunda_branches?     @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dunda_activity_branch_id_dunda_branches_id_fk")
  dunda_organizations dunda_organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_activity_organization_id_dunda_organizations_id_fk")
}

model dunda_audit_logs {
  id                  String              @id @default(uuid(7))
  organization_id     String
  branch_id           String?
  staff_id            String?
  action              String
  entity              String
  entity_id           String?
  detail              String?
  reason              String?
  previous_value      Json?
  new_value           Json?
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  dunda_branches      dunda_branches?     @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dunda_audit_logs_branch_id_dunda_branches_id_fk")
  dunda_organizations dunda_organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_audit_logs_organization_id_dunda_organizations_id_fk")
  dunda_staff         dunda_staff?        @relation(fields: [staff_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dunda_audit_logs_staff_id_dunda_staff_id_fk")
}

model dunda_billing_payments {
  id                               String                                @id @default(uuid(7))
  organization_id                  String
  subscription_id                  String
  kind                             String                                @default("SUBSCRIPTION")
  status                           String                                @default("INITIATED")
  amount                           Int
  currency                         String                                @default("KES")
  provider                         String                                @default("PESAPAL")
  provider_reference               String?
  provider_transaction_id          String?
  paid_at                          DateTime?                             @db.Timestamptz(6)
  refunded_amount                  Int                                   @default(0)
  failure_reason                   String?
  provider_payload                 Json?
  created_at                       DateTime                              @default(now()) @db.Timestamptz(6)
  updated_at                       DateTime                              @default(now()) @db.Timestamptz(6)
  dunda_organizations              dunda_organizations                   @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_billing_payments_organization_id_dunda_organizations_id_f")
  dunda_subscriptions              dunda_subscriptions                   @relation(fields: [subscription_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_billing_payments_subscription_id_dunda_subscriptions_id_f")
  dunda_invoices                   dunda_invoices[]
  dunda_payment_notifications      dunda_payment_notifications[]
  dundaPaymentAttempts             dunda_payment_attempts[]
  dundaPaymentProviderTransactions dunda_payment_provider_transactions[]

  @@unique([provider, provider_transaction_id], map: "dunda_billing_payments_txn")
  @@index([organization_id], map: "dunda_billing_payments_org")
}

model dunda_branch_members {
  id                  String              @id @default(uuid(7))
  organization_id     String
  branch_id           String
  clerk_user_id       String
  role_id             String
  status              String              @default("ACTIVE")
  joined_at           DateTime            @default(now()) @db.Timestamptz(6)
  dunda_branches      dunda_branches      @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_branch_members_branch_id_dunda_branches_id_fk")
  dunda_organizations dunda_organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_branch_members_organization_id_dunda_organizations_id_fk")
  dunda_roles         dunda_roles         @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dunda_branch_members_role_id_dunda_roles_id_fk")
}

model dunda_branches {
  id                                                                                String                              @id @default(uuid(7))
  organization_id                                                                   String
  name                                                                              String
  city                                                                              String
  address                                                                           String?
  status                                                                            String                              @default("LIVE")
  timezone                                                                          String                              @default("Africa/Nairobi")
  phone                                                                             String?
  email                                                                             String?
  active_tables                                                                     Int                                 @default(0)
  total_tables                                                                      Int                                 @default(0)
  revenue_today                                                                     Int                                 @default(0)
  created_at                                                                        DateTime                            @default(now()) @db.Timestamptz(6)
  updated_at                                                                        DateTime                            @default(now()) @db.Timestamptz(6)
  dunda_activity                                                                    dunda_activity[]
  dunda_audit_logs                                                                  dunda_audit_logs[]
  dunda_branch_members                                                              dunda_branch_members[]
  dunda_organizations                                                               dunda_organizations                 @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_branches_organization_id_dunda_organizations_id_fk")
  dunda_customers                                                                   dunda_customers[]
  dunda_document_counters                                                           dunda_document_counters[]
  dunda_events                                                                      dunda_events[]
  dunda_floors                                                                      dunda_floors[]
  dunda_inventory_alerts                                                            dunda_inventory_alerts[]
  dunda_inventory_items                                                             dunda_inventory_items[]
  dunda_notifications                                                               dunda_notifications[]
  dunda_event_guest_list                                                            dunda_event_guest_list[]
  dunda_event_tickets                                                               dunda_event_tickets[]
  dunda_expenses                                                                    dunda_expenses[]
  dunda_order_tickets                                                               dunda_order_tickets[]
  dunda_orders                                                                      dunda_orders[]
  dunda_payment_attempts                                                            dunda_payment_attempts[]
  dunda_payments                                                                    dunda_payments[]
  dunda_pool_rate_rules                                                             dunda_pool_rate_rules[]
  dunda_pool_sessions                                                               dunda_pool_sessions[]
  dunda_pool_tables                                                                 dunda_pool_tables[]
  dunda_product_branch_availability                                                 dunda_product_branch_availability[]
  dunda_receipts                                                                    dunda_receipts[]
  dunda_refunds                                                                     dunda_refunds[]
  dunda_reservations                                                                dunda_reservations[]
  dunda_staff                                                                       dunda_staff[]
  dunda_staff_shifts                                                                dunda_staff_shifts[]
  dunda_stock_counts                                                                dunda_stock_counts[]
  dunda_stock_movements                                                             dunda_stock_movements[]
  dunda_stock_transfers_dunda_stock_transfers_destination_branch_idTodunda_branches dunda_stock_transfers[]             @relation("dunda_stock_transfers_destination_branch_idTodunda_branches")
  dunda_stock_transfers_dunda_stock_transfers_source_branch_idTodunda_branches      dunda_stock_transfers[]             @relation("dunda_stock_transfers_source_branch_idTodunda_branches")
  dunda_tables                                                                      dunda_tables[]
  dunda_tabs                                                                        dunda_tabs[]
  dunda_vip_packages                                                                dunda_vip_packages[]
}

model dunda_categories {
  id                  String              @id @default(uuid(7))
  organization_id     String
  name                String
  color               String              @default("#6f9fb2")
  sort_order          Int                 @default(0)
  group               String?
  station             String?
  dunda_organizations dunda_organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_categories_organization_id_dunda_organizations_id_fk")
  dunda_products      dunda_products[]
}

model dunda_customers {
  id                       String                     @id @default(uuid(7))
  organization_id          String
  branch_id                String?
  name                     String
  phone                    String?
  email                    String?
  vip_level                String                     @default("NONE")
  total_visits             Int                        @default(0)
  total_spend              Int                        @default(0)
  last_visit_at            DateTime?                  @db.Timestamptz(6)
  notes                    String?
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @db.Timestamptz(6)
  dunda_branches           dunda_branches?            @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dunda_customers_branch_id_dunda_branches_id_fk")
  dunda_organizations      dunda_organizations        @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_customers_organization_id_dunda_organizations_id_fk")
  dunda_event_guest_list   dunda_event_guest_list[]
  dunda_event_reservations dunda_event_reservations[]
  dunda_event_tickets      dunda_event_tickets[]
  dunda_orders             dunda_orders[]
  dunda_pool_sessions      dunda_pool_sessions[]
  dunda_receipts           dunda_receipts[]
  dunda_reservations       dunda_reservations[]
  dundaTabs                dunda_tabs[]

  @@index([organization_id, phone], map: "dunda_customers_org_phone")
}

model dunda_document_counters {
  id                  String              @id @default(uuid(7))
  organization_id     String
  branch_id           String
  kind                String
  next_value          Int                 @default(1)
  updated_at          DateTime            @default(now()) @db.Timestamptz(6)
  dunda_branches      dunda_branches      @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_document_counters_branch_id_dunda_branches_id_fk")
  dunda_organizations dunda_organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_document_counters_organization_id_dunda_organizations_id_")
}

model dunda_event_reservations {
  id              String          @id @default(uuid(7))
  event_id        String
  customer_id     String
  guests          Int             @default(1)
  vip_package_id  String?
  status          String          @default("PENDING")
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  dunda_customers dunda_customers @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dunda_event_reservations_customer_id_dunda_customers_id_fk")
  dunda_events    dunda_events    @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_event_reservations_event_id_dunda_events_id_fk")
}

model dunda_events {
  id                       String                     @id @default(uuid(7))
  organization_id          String
  branch_id                String
  name                     String
  description              String?
  date                     String
  start_time               String
  end_time                 String
  capacity                 Int                        @default(0)
  status                   String                     @default("DRAFT")
  revenue                  Int                        @default(0)
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @db.Timestamptz(6)
  dunda_event_reservations dunda_event_reservations[]
  dunda_event_tickets      dunda_event_tickets[]
  dunda_event_guest_list   dunda_event_guest_list[]
  dunda_branches           dunda_branches             @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dunda_events_branch_id_dunda_branches_id_fk")
  dunda_organizations      dunda_organizations        @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_events_organization_id_dunda_organizations_id_fk")
}

model dunda_event_tickets {
  id                        String              @id @default(uuid(7))
  organization_id           String
  event_id                  String
  customer_id               String?
  checked_in_by_id          String?
  code                      String
  guest_name                String
  phone                     String?
  ticket_type               String              @default("GENERAL")
  price                     Int                 @default(0)
  quantity                  Int                 @default(1)
  amount                    Int                 @default(0)
  status                    String              @default("ISSUED")
  sold_at                   DateTime            @default(now()) @db.Timestamptz(6)
  checked_in_at             DateTime?           @db.Timestamptz(6)
  dunda_branches            dunda_branches?     @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dunda_event_tickets_branch_id_dunda_branches_id_fk")
  branch_id                 String?
  dunda_customers           dunda_customers?    @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dunda_event_tickets_customer_id_dunda_customers_id_fk")
  dunda_events              dunda_events        @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_event_tickets_event_id_dunda_events_id_fk")
  dunda_organizations       dunda_organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_event_tickets_organization_id_dunda_organizations_id_fk")
  dunda_staff_checked_in_by dunda_staff?        @relation("dunda_event_tickets_checked_in_by", fields: [checked_in_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dunda_event_tickets_checked_in_by_id_dunda_staff_id_fk")

  @@unique([event_id, code], map: "dunda_event_tickets_event_code")
  @@index([organization_id, event_id], map: "dunda_event_tickets_org_event")
}

model dunda_event_guest_list {
  id                        String              @id @default(uuid(7))
  organization_id           String
  event_id                  String
  customer_id               String?
  checked_in_by_id          String?
  name                      String
  phone                     String?
  email                     String?
  guests                    Int                 @default(1)
  vip_package_id            String?
  status                    String              @default("EXPECTED")
  checked_in_at             DateTime?           @db.Timestamptz(6)
  notes                     String?
  created_at                DateTime            @default(now()) @db.Timestamptz(6)
  dunda_branches            dunda_branches?     @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dunda_event_guest_list_branch_id_dunda_branches_id_fk")
  branch_id                 String?
  dunda_customers           dunda_customers?    @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dunda_event_guest_list_customer_id_dunda_customers_id_fk")
  dunda_events              dunda_events        @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_event_guest_list_event_id_dunda_events_id_fk")
  dunda_organizations       dunda_organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_egl_org_id_fk")
  dunda_staff_checked_in_by dunda_staff?        @relation("dunda_event_guest_list_checked_in_by", fields: [checked_in_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dunda_event_guest_list_checked_in_by_id_dunda_staff_id_fk")

  @@index([organization_id, event_id], map: "dunda_event_guest_list_org_event")
}

model dunda_expenses {
  id                  String              @id @default(uuid(7))
  organization_id     String
  branch_id           String
  recorded_by_id      String?
  category            String
  description         String
  amount              Int
  currency            String              @default("KES")
  expense_date        DateTime            @db.Timestamptz(6)
  payment_method      String              @default("CASH")
  reference           String?
  vendor              String?
  status              String              @default("RECORDED")
  notes               String?
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  dunda_branches      dunda_branches      @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_expenses_branch_id_dunda_branches_id_fk")
  dunda_organizations dunda_organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_expenses_organization_id_dunda_organizations_id_fk")
  recorded_by         dunda_staff?        @relation("dunda_expenses_recorded_by", fields: [recorded_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dunda_expenses_recorded_by_id_dunda_staff_id_fk")

  @@index([organization_id, expense_date], map: "dunda_expenses_org_date")
  @@index([organization_id, category], map: "dunda_expenses_org_category")
}

model dunda_floor_sections {
  id           String       @id @default(uuid(7))
  floor_id     String
  name         String
  color        String       @default("#f07a4b")
  sort_order   Int          @default(0)
  dunda_floors dunda_floors @relation(fields: [floor_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_floor_sections_floor_id_dunda_floors_id_fk")
}

model dunda_floors {
  id                   String                 @id @default(uuid(7))
  branch_id            String
  name                 String
  sort_order           Int                    @default(0)
  dunda_floor_sections dunda_floor_sections[]
  dunda_branches       dunda_branches         @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_floors_branch_id_dunda_branches_id_fk")
  dunda_tables         dunda_tables[]
}

model dunda_inventory_alerts {
  id                  String              @id @default(uuid(7))
  organization_id     String
  branch_id           String
  product_id          String
  name                String
  category            String
  stock               Decimal             @db.Decimal(12, 2)
  minimum             Decimal             @db.Decimal(12, 2)
  unit                String
  severity            String              @default("LOW")
  /// When the alert was raised. The feed needs an order to sort by and the table
  /// had no timestamp at all, so every alert would otherwise be undated.
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  dunda_branches      dunda_branches      @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_inventory_alerts_branch_id_dunda_branches_id_fk")
  dunda_organizations dunda_organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_inventory_alerts_organization_id_dunda_organizations_id_f")
  dunda_products      dunda_products      @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dunda_inventory_alerts_product_id_dunda_products_id_fk")
}

model dunda_inventory_items {
  id                  String              @id @default(uuid(7))
  organization_id     String
  branch_id           String
  product_id          String?
  name                String
  category            String?
  sku                 String?
  unit                String              @default("piece")
  current_quantity    Decimal             @default(0) @db.Decimal(12, 2)
  reorder_level       Decimal             @default(0) @db.Decimal(12, 2)
  cost                Int                 @default(0)
  supplier_id         String?
  dunda_branches      dunda_branches      @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_inventory_items_branch_id_dunda_branches_id_fk")
  dunda_organizations dunda_organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_inventory_items_organization_id_dunda_organizations_id_fk")
  dunda_products      dunda_products?     @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dunda_inventory_items_product_id_dunda_products_id_fk")
}

model dunda_invoices {
  id                     String                  @id @default(uuid(7))
  number                 String
  organization_id        String
  subscription_id        String
  billing_payment_id     String?
  amount                 Int
  tax_amount             Int                     @default(0)
  total                  Int
  currency               String                  @default("KES")
  status                 String                  @default("ISSUED")
  period_start           DateTime?               @db.Timestamptz(6)
  period_end             DateTime?               @db.Timestamptz(6)
  issued_at              DateTime                @default(now()) @db.Timestamptz(6)
  voided_at              DateTime?               @db.Timestamptz(6)
  dunda_billing_payments dunda_billing_payments? @relation(fields: [billing_payment_id], references: [id], onUpdate: NoAction, map: "dunda_invoices_billing_payment_id_dunda_billing_payments_id_fk")
  dunda_organizations    dunda_organizations     @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_invoices_organization_id_dunda_organizations_id_fk")
  dunda_subscriptions    dunda_subscriptions     @relation(fields: [subscription_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_invoices_subscription_id_dunda_subscriptions_id_fk")

  @@unique([organization_id, number], map: "dunda_invoices_org_number")
}

model dunda_notifications {
  id                  String              @id @default(uuid(7))
  organization_id     String
  branch_id           String?
  /// A notification addressed to a person. Null means the whole club sees it,
  /// which is how low-stock and failed-payment warnings reach whoever is on shift.
  staff_id            String?
  type                String
  title               String
  message             String
  /// "true"/"false" rather than a boolean, matching the rest of the legacy schema.
  read                String              @default("false")
  read_at             DateTime?           @db.Timestamptz(6)
  reference_id        String?
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  dunda_branches      dunda_branches?     @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dunda_notifications_branch_id_dunda_branches_id_fk")
  dunda_organizations dunda_organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_notifications_organization_id_dunda_organizations_id_fk")
  dunda_staff         dunda_staff?        @relation(fields: [staff_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_notifications_staff_id_dunda_staff_id_fk")
}

model dunda_order_item_units {
  id                    String            @id @default(uuid(7))
  order_item_id         String
  unit_id               String
  unit_name             String
  conversion_factor     Decimal           @db.Decimal(12, 4)
  quantity_in_base_unit Decimal           @db.Decimal(12, 4)
  dunda_order_items     dunda_order_items @relation(fields: [order_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_order_item_units_order_item_id_dunda_order_items_id_fk")
}

model dunda_order_items {
  id                       String                     @id @default(uuid(7))
  order_id                 String
  product_id               String
  unit_id                  String?
  name                     String
  quantity                 Int
  unit_price               Int
  total                    Int
  notes                    String?
  category_id              String?
  dunda_order_item_units   dunda_order_item_units[]
  dunda_orders             dunda_orders               @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_order_items_order_id_dunda_orders_id_fk")
  dunda_products           dunda_products             @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dunda_order_items_product_id_dunda_products_id_fk")
  dunda_order_ticket_items dunda_order_ticket_items[]
}

model dunda_order_ticket_items {
  id                  String              @id @default(uuid(7))
  organization_id     String
  ticket_id           String
  order_item_id       String?
  name                String
  quantity            Int
  notes               String?
  tab_item_id         String?
  dunda_order_items   dunda_order_items?  @relation(fields: [order_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_order_ticket_items_order_item_id_dunda_order_items_id_fk")
  dunda_organizations dunda_organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_order_ticket_items_organization_id_dunda_organizations_id")
