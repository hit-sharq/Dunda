  id                  String              @id @default(uuid(7))
  organization_id     String
  name                String
  contact             String?
  phone               String?
  email               String?
  address             String?
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  dunda_organizations dunda_organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_suppliers_organization_id_dunda_organizations_id_fk")
}

model dunda_tab_item_units {
  id                    String          @id @default(uuid(7))
  tab_item_id           String
  unit_id               String
  unit_name             String
  conversion_factor     Int
  quantity_in_base_unit Int
  dunda_tab_items       dunda_tab_items @relation(fields: [tab_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_tab_item_units_tab_item_id_dunda_tab_items_id_fk")
}

model dunda_tab_items {
  id                       String                     @id @default(uuid(7))
  organization_id          String
  tab_id                   String
  product_id               String
  name                     String
  quantity                 Int
  unit_price               Int
  total                    Int
  category                 String
  unit_id                  String?
  unit_name                String?
  notes                    String?
  dunda_order_ticket_items dunda_order_ticket_items[]
  dunda_tab_item_units     dunda_tab_item_units[]
  dunda_organizations      dunda_organizations        @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_tab_items_organization_id_dunda_organizations_id_fk")
  dunda_products           dunda_products             @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dunda_tab_items_product_id_dunda_products_id_fk")
  dunda_tabs               dunda_tabs                 @relation(fields: [tab_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_tab_items_tab_id_dunda_tabs_id_fk")
}

model dunda_tables {
  id                  String               @id @default(uuid(7))
  organization_id     String
  branch_id           String
  floor_id            String?
  floor_section_id    String?
  name                String
  section             String
  seats               Int                  @default(4)
  status              String               @default("AVAILABLE")
  total               Int                  @default(0)
  tab_id              String?
  customer            String?
  x                   Int                  @default(0)
  y                   Int                  @default(0)
  width               Int                  @default(120)
  height              Int                  @default(120)
  dunda_orders        dunda_orders[]
  dunda_branches      dunda_branches       @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_tables_branch_id_dunda_branches_id_fk")
  dunda_floors        dunda_floors?        @relation(fields: [floor_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_tables_floor_id_dunda_floors_id_fk")
  dunda_organizations dunda_organizations  @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_tables_organization_id_dunda_organizations_id_fk")
  dunda_tabs          dunda_tabs[]
  dunda_reservations  dunda_reservations[]

  @@unique([branch_id, name], map: "dunda_tables_branch_name")
  @@index([organization_id, status], map: "dunda_tables_org_status")
}

model dunda_tabs {
  id                  String                @id @default(uuid(7))
  organization_id     String
  branch_id           String
  number              String                @unique(map: "dunda_tabs_number_unique")
  customer            String
  table_name          String
  status              String                @default("OPEN")
  customer_id         String?
  staff_id            String?
  bar_total           Int                   @default(0)
  food_total          Int                   @default(0)
  pool_total          Int                   @default(0)
  subtotal            Int                   @default(0)
  service_charge      Int                   @default(0)
  tax                 Int                   @default(0)
  discount            Int                   @default(0)
  total               Int                   @default(0)
  amount_paid         Int                   @default(0)
  outstanding         Int                   @default(0)
  opened_at           DateTime              @default(now()) @db.Timestamptz(6)
  closed_at           DateTime?             @db.Timestamptz(6)
  closed_by_id        String?
  allowed_on_account  Boolean               @default(false)
  table_id            String?
  dunda_order_tickets dunda_order_tickets[]
  dunda_orders        dunda_orders[]
  dunda_payments      dunda_payments[]
  dunda_payment_attempts dunda_payment_attempts[]
  dunda_pool_sessions dunda_pool_sessions[]
  dunda_receipts      dunda_receipts[]
  dunda_tab_items     dunda_tab_items[]
  dunda_branches      dunda_branches        @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dunda_tabs_branch_id_dunda_branches_id_fk")
  dunda_customers     dunda_customers?      @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dunda_tabs_customer_id_dunda_customers_id_fk")
  dunda_organizations dunda_organizations   @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_tabs_organization_id_dunda_organizations_id_fk")
  dunda_staff         dunda_staff?          @relation(fields: [staff_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dunda_tabs_staff_id_dunda_staff_id_fk")
  dunda_tables        dunda_tables?         @relation(fields: [table_id], references: [id], onUpdate: NoAction, map: "dunda_tabs_table_id_dunda_tables_id_fk")

  @@index([organization_id, status], map: "dunda_tabs_org_status")
  @@index([organization_id, branch_id, status], map: "dunda_tabs_org_branch_status")
}

model dunda_organization_settings {
  id                  String              @id @default(uuid(7))
  organization_id     String              @unique(map: "dunda_org_settings_org_unique")
  currency            String              @default("KES")
  timezone            String              @default("Africa/Nairobi")
  tax_rate            Int                 @default(16)
  tax_inclusive       Boolean             @default(false)
  service_charge_rate Int                 @default(10)
  service_charge_mode String              @default("PERCENT")
  receipt_footer      String?
  invoice_footer      String?
  settings            Json                @default("{}")
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  updated_at          DateTime            @default(now()) @db.Timestamptz(6)
  dunda_organizations dunda_organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_org_settings_organization_id_dunda_organizations_id_fk")
}

model dunda_organization_features {
  id                  String              @id @default(uuid(7))
  organization_id     String
  module              String
  enabled             Boolean             @default(true)
  updated_by_id       String?
  updated_at          DateTime            @default(now()) @db.Timestamptz(6)
  dunda_organizations dunda_organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_org_features_organization_id_dunda_organizations_id_fk")

  @@unique([organization_id, module], map: "dunda_org_features_org_module")
}

model dunda_platform_users {
  id                             String                      @id @default(uuid(7))
  clerk_user_id                  String                      @unique(map: "dunda_platform_users_clerk_user_id_unique")
  email                          String?
  name                           String?
  role                           String                      @default("PLATFORM_ADMIN")
  status                         String                      @default("ACTIVE")
  last_login_at                  DateTime?                   @db.Timestamptz(6)
  created_at                     DateTime                    @default(now()) @db.Timestamptz(6)
  dunda_platform_audit_logs      dunda_platform_audit_logs[]
  dunda_support_tickets_assigned dunda_support_tickets[]     @relation("dunda_support_tickets_assigned_to")
}

model dunda_support_tickets {
  id                            String                @id @default(uuid(7))
  organization_id               String?
  opened_by_clerk_user_id       String?
  assigned_to_id                String?
  subject                       String
  category                      String                @default("CUSTOMER_ISSUE")
  priority                      String                @default("NORMAL")
  status                        String                @default("OPEN")
  body                          String
  resolution                    String?
  created_at                    DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime              @default(now()) @db.Timestamptz(6)
  resolved_at                   DateTime?             @db.Timestamptz(6)
  dunda_organizations           dunda_organizations?  @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_support_tickets_organization_id_dunda_organizations_id_fk")
  dunda_platform_users_assigned dunda_platform_users? @relation("dunda_support_tickets_assigned_to", fields: [assigned_to_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dunda_support_tickets_assigned_to_id_dunda_platform_users_id_fk")

  @@index([status], map: "dunda_support_tickets_status")
}

model dunda_platform_audit_logs {
  id                   String                @id @default(uuid(7))
  actor_id             String?
  organization_id      String?
  actor_clerk_user_id  String?
  action               String
  entity               String
  entity_id            String?
  detail               String?
  previous_value       Json?
  new_value            Json?
  ip_address           String?
  created_at           DateTime              @default(now()) @db.Timestamptz(6)
  dunda_organizations  dunda_organizations?  @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dunda_pal_org_id_fk")
  dunda_platform_users dunda_platform_users? @relation(fields: [actor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dunda_platform_audit_logs_actor_id_dunda_platform_users_id_fk")

  @@index([organization_id, created_at], map: "dunda_platform_audit_logs_org_created")
  @@index([created_at], map: "dunda_platform_audit_logs_created")
}

model dunda_vip_packages {
  id                  String              @id @default(uuid(7))
  organization_id     String
  branch_id           String
