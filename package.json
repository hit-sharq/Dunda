{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter @workspace/dunda dev",
    "dev:server": "pnpm --filter @workspace/api-server dev",
    "dev:mobile": "pnpm --filter @workspace/dunda-mobile dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:web": "pnpm --filter @workspace/dunda build",
    "build:server": "pnpm --filter @workspace/api-server build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "db:push": "pnpm --filter @workspace/db push",
    "db:generate": "pnpm --filter @workspace/db generate",
    "db:migrate": "pnpm --filter @workspace/db migrate",
    "db:studio": "pnpm --filter @workspace/db studio",
    "db:seed": "pnpm --filter @workspace/db seed",
    "api:codegen": "pnpm --filter @workspace/api-spec codegen",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm run typecheck && pnpm test && pnpm run build",
    "build:vercel": "pnpm --filter @workspace/api-server build && pnpm --filter @workspace/dunda build",
    "dev:admin": "pnpm --filter @workspace/admin dev",
    "build:admin": "pnpm --filter @workspace/admin build",
    "dev:all": "concurrently \"pnpm dev:server\" \"pnpm dev:web\" \"pnpm dev:admin\""
  },
  "private": true,
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "supertest": "^7.1.1",
    "@types/supertest": "^6.0.3"
  }
}
